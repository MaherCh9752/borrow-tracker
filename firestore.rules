rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared entries — the new shared entry system
    match /shared_entries/{entryId} {
      // Only participants can read
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Any authenticated user can create (must include self in participants)
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 1;

      // Participants can update; also allows a user being linked to accept
      // by adding themselves as a participant in the same update
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (request.auth.uid == request.resource.data.linkedUserId
          && request.auth.uid in request.resource.data.participants)
      );

      // Only the creator can delete
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Users collection — read access for UserPicker, write for owner
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy per-user entries (backward compatibility)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pending invites — user invitation system
    match /pending_invites/{inviteId} {
      // Anyone can read by invite code (unauthenticated users on signup screen).
      // The 6-char random code provides sufficient access control.
      allow read: if true;

      // Any authenticated user can create an invite
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy;

      // Creator can update; anyone can accept a pending invite by code
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        (resource.data.status == 'pending'
          && request.resource.data.status == 'accepted')
      );

      // Only the creator can delete
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Change requests — edit approval workflow
    match /change_requests/{requestId} {
      // Participants can read
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Any authenticated user can create (must include self in participants)
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.requestedBy
        && request.auth.uid in request.resource.data.participants;

      // Participants can update (accept/reject/cancel)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Requester can delete their own
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.requestedBy;
    }
  }
}
